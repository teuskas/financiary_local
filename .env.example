# Dropbox OAuth2 access token
# Generate one at https://www.dropbox.com/developers/apps
DROPBOX_ACCESS_TOKEN=your_access_token_here

# Dropbox folder path containing financial CSV files (default: /)
DROPBOX_FOLDER_PATH=/financiary

# CSV column names (comma-separated list matching your file headers)
CSV_DATE_COLUMN=date
CSV_AMOUNT_COLUMN=amount
CSV_DESCRIPTION_COLUMN=description
CSV_CATEGORY_COLUMN=category
